<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs the daily MLB trend video pipeline every morning.

  launchd's StartCalendarInterval fires in the Mac's LOCAL system time zone,
  which on this machine is US/Mountain (MST/MDT). Hour=6/Minute=5 here means
  6:05 AM Mountain = 8:05 AM ET — deliberately later than the earlier 6:30 AM
  ET schedule, to give same-day starting-pitcher data more time to firm up
  before scripts get generated. Shifted 5 min later (from 6:00) so it doesn't
  start at the exact same instant as com.getstam.nfl-daily-import.plist,
  which also fires at 6:00.

  Install:
    cp scripts/com.getstam.mlbtrendvideos.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.getstam.mlbtrendvideos.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.getstam.mlbtrendvideos.plist
    rm ~/Library/LaunchAgents/com.getstam.mlbtrendvideos.plist

  Run immediately (without waiting for the schedule), to test:
    launchctl start com.getstam.mlbtrendvideos

  Requires this Mac to be powered on at run time — launchd will NOT wake a
  sleeping Mac on its own, so a scheduled wake is still needed. That wake
  moved from 5:55 to 3:55 AM when com.getstam.mlb-daily-import.plist moved
  to 4:00 AM (pmset only supports one repeating wake time), with
  com.getstam.morning-wake-bridge.plist holding the Mac awake in between:
    sudo pmset repeat wakeorpoweron MTWRFSU 03:55:00
  Once running, the job is wrapped in `caffeinate -i -s -m -d`, which blocks
  every sleep type caffeinate can prevent (idle, system, disk, display) for
  the duration of the pipeline. `-i` alone (an earlier version of this file)
  was NOT enough — it only blocks *idle* sleep, not macOS's periodic
  "Maintenance Sleep" / Power Nap cycles, which kept firing every ~15 min
  regardless and killed a Claude API connection mid-request, hanging the
  job silently for 2+ hours with no error. `-s` requires AC power to have
  effect, so this Mac needs to stay plugged in overnight for the guarantee
  to actually hold.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.getstam.mlbtrendvideos</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>-s</string>
        <string>-m</string>
        <string>-d</string>
        <string>/Users/getstam/Documents/getstam/get-stam-py/scripts/run_daily_trend_video_pipeline.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/getstam/Documents/getstam/get-stam-py/logs/launchd_mlbtrendvideos.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/getstam/Documents/getstam/get-stam-py/logs/launchd_mlbtrendvideos.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
