# Ignore the .env file
.env

# Ignore virtual environment directories
.venv/
venv/

# Ignore Python cache files
__pycache__/
*.py[cod]

# Ignore the app.log file
app.log

# Ignore macOS Finder metadata
.DS_Store

# Ignore local job logs (pipeline runs, daily import wrappers, launchd out/err)
logs/

# Ignore the mlb_starting_pitchers.json file
mlb_starting_pitchers.json

# Ignore generated job output (e.g. jobs/mlb_generate_trend_video_scripts.py)
output/

# Ignore YouTube OAuth credentials (see jobs/mlb_upload_youtube_videos.py)
youtube_client_secret.json
youtube_token.json

# Ignore downloaded Piper TTS voice models (~100-200MB each, see
# jobs/mlb_generate_trend_videos.py's docstring for the download commands)
piper_voices/

# Ignore Node.js files (not relevant for Python project)
package-lock.json
node_modules/