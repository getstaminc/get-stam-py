<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs the daily MLB trend video pipeline every morning.

  launchd's StartCalendarInterval fires in the Mac's LOCAL system time zone,
  which on this machine is US/Mountain (MST/MDT). Hour=6/Minute=0 here means
  6:00 AM Mountain = 8:00 AM ET — deliberately later than the earlier 6:30 AM
  ET schedule, to give same-day starting-pitcher data more time to firm up
  before scripts get generated.

  Install:
    cp scripts/com.getstam.mlbtrendvideos.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.getstam.mlbtrendvideos.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.getstam.mlbtrendvideos.plist
    rm ~/Library/LaunchAgents/com.getstam.mlbtrendvideos.plist

  Run immediately (without waiting for the schedule), to test:
    launchctl start com.getstam.mlbtrendvideos

  Requires this Mac to be powered on at run time — launchd will NOT wake a
  sleeping Mac on its own, so a scheduled wake is still needed:
    sudo pmset repeat wakeorpoweron MTWRFSU 05:55:00
  Once running, the job is wrapped in `caffeinate -i`, which holds an
  idle-sleep assertion for the ~15-20 min the pipeline takes — this is what
  broke a run earlier (the Mac went back to sleep mid-render and corrupted
  a video) — so it won't happen again once the wake fires and the job starts.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.getstam.mlbtrendvideos</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/Users/getstam/Documents/getstam/get-stam-py/scripts/run_daily_trend_video_pipeline.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/getstam/Documents/getstam/get-stam-py/logs/launchd_mlbtrendvideos.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/getstam/Documents/getstam/get-stam-py/logs/launchd_mlbtrendvideos.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
